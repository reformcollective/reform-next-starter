{
	"permissions": {
		"allow": [
			"Bash(WIREIT_LOGGER=metrics pnpm lint)",
			"Bash(pnpm exec *)",
			"Bash(pnpm sanity *)",
			"Bash(pnpm check:comments)",
			"Bash(pnpm check:compiler)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git worktree add *)",
			"Bash(git worktree list*)",
			"Bash(git worktree remove *)",
			"Bash(git branch -d *)",
			"Bash(git switch *)"
		],
		"ask": ["Bash(git push *)", "Bash(gh pr create *)", "Bash(git merge --no-ff *)"],
		"deny": [
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push * main*)",
			"Bash(git push * staging*)",
			"Bash(git reset --hard*)",
			"Bash(git checkout *)",
			"Bash(git restore *)",
			"Bash(git stash*)",
			"Bash(git rebase *)",
			"Bash(git branch -D*)",
			"Bash(git worktree remove --force*)",
			"Bash(git worktree remove -f*)",
			"Bash(git switch --discard-changes*)",
			"Bash(git switch -f*)",
			"Bash(git switch --force*)",
			"Bash(git commit --amend*)",
			"Bash(gh pr merge*)",
			"Bash(vercel *)",
			"Bash(*rule-changes*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Edit(./library/agent/**)",
			"Edit(./.claude/**)",
			"Edit(./CLAUDE.md)",
			"Edit(../worktrees/*/*/library/agent/**)",
			"Edit(../worktrees/*/*/.claude/**)",
			"Edit(../worktrees/*/*/CLAUDE.md)"
		],
		"additionalDirectories": ["../worktrees/"]
	},
	"attribution": { "commit": "", "pr": "", "sessionUrl": false },
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/library/agent/hooks/sweep.mjs\""
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Read",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/library/agent/hooks/no-big-reads.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && node library/agent/hooks/check-comments.mjs --hook"
					},
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && node library/agent/hooks/check-compiler.mjs --hook"
					}
				]
			}
		]
	},
	"statusLine": { "type": "command", "command": "bash library/agent/statusline.sh" }
}
