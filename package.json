{
	"name": "website",
	"private": true,
	"author": "Reform Collective",
	"type": "module",
	"scripts": {
		"dev": "wireit",
		"build": "wireit",
		"serve": "wireit",
		"test": "wireit",
		"lint": "wireit",
		"format": "wireit",
		"init-project": "pnpm install && pnpm dev",
		"pnpm:devPreinstall": "pnpm init-submodule && pnpm git-config",
		"postinstall": "pnpm check-env",
		"prepare": "lefthook install",
		"check-env": "if [ -n \"$CI\" ]; then exit 0; else node --env-file=.env app/env.ts || (pnpm dlx cowsay 'You are missing a .env file' && exit 1); fi",
		"git-config": "git config submodule.recurse true",
		"init-submodule": "git submodule update --init",
		"check-projections": "wireit"
	},
	"wireit": {
		"dev": {
			"command": "next dev",
			"dependencies": [
				"typegen:dev"
			],
			"service": true
		},
		"serve": {
			"command": "next start",
			"dependencies": [
				"build"
			],
			"service": true
		},
		"build-next": {
			"command": "next build"
		},
		"build": {
			"dependencies": [
				"build-next",
				"generate-manifest"
			]
		},
		"generate-manifest": {
			"command": "mkdir -p public/studio && sanity manifest extract --path public/studio/static",
			"files": [
				".env",
				"app/env.ts",
				"library/**/*.ts",
				"library/**/*.tsx",
				"sanity/**/*",
				"sanity.config.ts",
				"sanity.cli.ts",
				"tsconfig.json"
			],
			"output": [
				"public/studio/static/**/*"
			]
		},
		"sanity-schema:dev": {
			"command": "sanity schema extract --watch --force",
			"service": true
		},
		"typegen:dev": {
			"command": "sanity typegen generate --watch",
			"dependencies": [
				"sanity-schema:dev"
			],
			"service": true
		},
		"sanity-typegen:check": {
			"command": "(sanity schema extract && sanity typegen generate) || (pnpm exec sanity schema validate)",
			"files": [
				".env",
				"sanity/**/*",
				"sanity.config.ts",
				"sanity.cli.ts",
				"tsconfig.json",
				"app/**/*.ts",
				"app/**/*.tsx",
				"app/**/*.js",
				"app/**/*.jsx",
				"library/**/*.ts",
				"library/**/*.tsx",
				"library/**/*.js",
				"library/**/*.jsx"
			],
			"output": [
				"schema.json",
				"sanity.types.ts"
			]
		},
		"next-typegen:check": {
			"command": "next typegen",
			"files": [
				"app/**/*.ts",
				"app/**/*.tsx",
				"library/siteURL/**/*.ts",
				"library/vanilla/**/*.ts",
				"next.config.ts",
				"tsconfig.json"
			],
			"output": [
				".next/types/**/*.ts",
				"next-env.d.ts"
			]
		},
		"typegen:check": {
			"dependencies": [
				"next-typegen:check",
				"sanity-typegen:check"
			]
		},
		"stylelint": {
			"command": "stylelint . --fix"
		},
		"oxlint": {
			"command": "oxlint --fix",
			"dependencies": [
				"typegen:check"
			]
		},
		"lint": {
			"dependencies": [
				"stylelint",
				"oxlint",
				"check-projections"
			]
		},
		"oxfmt": {
			"command": "oxfmt"
		},
		"format": {
			"dependencies": [
				"oxfmt"
			]
		},
		"test": {
			"dependencies": [
				"./library:test"
			]
		},
		"check-projections": {
			"command": "node --experimental-strip-types scripts/check-section-projections.ts",
			"files": [
				"scripts/check-section-projections.ts",
				"sanity/schemas/sections/**/*.ts"
			],
			"output": []
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@capsizecss/core": "^4.1.3",
		"@sanity/assist": "^6.2.5",
		"@sanity/client": "^8.11.0",
		"@sanity/code-input": "^7.3.14",
		"@sanity/icons": "^5.2.3",
		"@sanity/ui": "^3.2.0",
		"@sanity/vision": "^6.20.0",
		"@svgr/webpack": "^8.1.0",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@userback/widget": "^0.3.13",
		"@vanilla-extract/css": "^1.21.3",
		"ahooks": "^3.10.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"gsap": "^3.15.0",
		"lefthook": "^2.2.2",
		"next": "^16.4.3",
		"next-sanity": "^13.4.0",
		"nuqs": "^2.10.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-player": "^3.4.0",
		"sanity": "^6.20.0",
		"sanity-plugin-asset-source-unsplash": "^7.0.30",
		"sanity-plugin-link-field": "file:library/vendor/sanity-plugin-link-field-1.6-preview.tgz",
		"sanity-plugin-media": "^6.5.0",
		"sanity-plugin-mux-input": "^5.2.0",
		"server-only": "^0.0.1",
		"stylelint": "^17.16.0",
		"svgo": "^4.1.0",
		"typescript": "^6.0.3",
		"unlighthouse": "^0.19.1",
		"vite-tsconfig-paths": "^6.1.1",
		"wireit": "^0.15.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@plutotcool/fsv": "0.5.1"
	},
	"stylelint": {
		"extends": "./library/config/stylelint.config.js",
		"rules": {
			"plugin/use-baseline": [
				true,
				{
					"available": 2024,
					"ignoreSelectors": [
						"/^view-transition-/"
					],
					"ignoreProperties": {
						"background-clip": [
							"text"
						],
						"view-transition-name": [],
						"text-wrap": [
							"pretty"
						],
						"user-select": [
							"none"
						],
						"overscroll-behavior": [
							"contain"
						]
					}
				}
			]
		}
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.18.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.7.0"
}
